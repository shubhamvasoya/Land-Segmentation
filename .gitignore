# =============================================================================
# Delineate Anything — .gitignore
# =============================================================================
# Large data files, model weights, and outputs are NEVER committed to git.
# Use placeholder .gitkeep files to preserve the directory structure instead.
# =============================================================================

# ─── Satellite Imagery (VERY large rasters) ──────────────────────────────────
data/images/**/*.tif
data/images/**/*.tiff
data/images/**/*.vrt
data/"New Images"/**/*.tif
data/"New Images"/**/*.tiff
data/New Images/*.tif
data/New Images/*.tiff
data/New Images/*.aux.xml

# ─── LCLU / Mask Rasters ─────────────────────────────────────────────────────
data/masks/**/*.tif
data/masks/**/*.tiff

# ─── Delineation Outputs (GeoPackages, Shapefiles) ───────────────────────────
data/delineated/**/*.gpkg
data/delineated/**/*.gpkg.aux.xml
data/delineated/**/*.shp
data/delineated/**/*.shx
data/delineated/**/*.dbf
data/delineated/**/*.prj
data/delineated/**/*.cpg
data/delineated/**/*.qpj

# Allow .gitkeep placeholder files (preserve empty folder structure)
!data/**/.gitkeep

# ─── Temporary / Intermediate Files ──────────────────────────────────────────
data/temp/
*.tmp
*.cache

# ─── GDAL / QGIS Auxiliary Files ─────────────────────────────────────────────
*.aux.xml
*.ovr
*.tfw
*.tifw
*.jgw
*.wld
*.qgz
*.qlr

# ─── Pretrained Model Weights ────────────────────────────────────────────────
*.pt
*.pth
*.onnx
*.engine
*.weights
SAM/weights/
SAM/**/*.pt
SAM/**/*.pth

# ─── Python Artifacts ────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
*.egg-info/
dist/
build/

# ─── Jupyter Notebooks Checkpoints ───────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ─── IDE / OS Artifacts ──────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ─── Log Files ───────────────────────────────────────────────────────────────
*.log
logs/

# ─── Sample Report (large Word document) ─────────────────────────────────────
Sample Report.docx
